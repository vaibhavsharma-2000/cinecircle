# TMDB API Key (Free from https://www.themoviedb.org/settings/api)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_access_token_here

# Supabase Credentials (Free from https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Environment Mode: Set 'true' for Staging/Local Testing (preloads mock circle data & demo user)
# Set 'false' in Production for pristine zero-mock state
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
